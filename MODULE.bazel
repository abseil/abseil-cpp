# https://bazel.build/external/overview#bzlmod

module(
    name = "abseil-cpp",
    version = "head",
)

cc_configure = use_extension(
    "@rules_cc//cc:extensions.bzl",
    "cc_configure_extension",
    dev_dependency = True,
)
use_repo(cc_configure, "local_config_cc")

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# Note: rules_foreign_cc is NOT a dev_dependency. It provides //CMake:absl, a
# CMake build of Abseil for Bazel users that also build with CMake. Its module
# and toolchain declarations join the dependency graph, but nothing from it is
# fetched or built unless that target is used.
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")

bazel_dep(
    name = "google_benchmark",
    version = "1.9.5",
    dev_dependency = True,
)

# Note: Googletest is NOT a dev_dependency. Some Abseil test utilities
# intended to be used by Abseil users depend on GoogleTest.
bazel_dep(
    name = "googletest",
    version = "1.18.0",
)

# The CMake source trees of Abseil and of GoogleTest (which Abseil's test
# helper libraries need), each as a single Bazel target: the inputs of
# //CMake:absl and //CMake:googletest. See CMake/cmake_sources.bzl.
cmake_sources = use_repo_rule("//CMake:cmake_sources.bzl", "cmake_sources")

cmake_sources(
    name = "abseil-cpp-cmake-sources",
    dirs = [
        "CMake",
        "absl",
    ],
    files = ["CMakeLists.txt"],
    root = "//:CMakeLists.txt",
)

cmake_sources(
    name = "googletest-cmake-sources",
    dirs = [
        "googlemock",
        "googletest",
    ],
    files = ["CMakeLists.txt"],
    root = "@googletest//:CMakeLists.txt",
)

# Note: Gloop is NOT a dev_dependency, but should never be used directly.  It is only included here
# so that we can give visibility into Abseil internals.
bazel_dep(
    name = "gloop",
    version = "20260708.rc1",
    repo_name = "do_not_use_for_gloop_visibility_only",
)
