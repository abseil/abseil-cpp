# Verification of our CI toolchains.

cc_test(
    name = "toolchain_test",
    srcs = ["toolchain_test.cc"],
    local_defines = select({
        ":clang_compiler": ["ABSL_CI_EXPECT_COMPILER_CLANG=1"],
        ":gcc_compiler": ["ABSL_CI_EXPECT_COMPILER_GCC=1"],
        ":msvc_compiler": ["ABSL_CI_EXPECT_COMPILER_MSVC=1"],
        ":clang_cl_compiler": ["ABSL_CI_EXPECT_COMPILER_CLANG_CL=1"],
        "//conditions:default": [],
    }) + select({
        ":libcxx_enabled": ["ABSL_CI_EXPECT_STDLIB_LIBCXX=1"],
        ":libstdcxx_enabled": ["ABSL_CI_EXPECT_STDLIB_LIBSTDCXX=1"],
        ":msvc_stdlib_enabled": ["ABSL_CI_EXPECT_STDLIB_MSVC=1"],
        "//conditions:default": [],
    }) + select({
        ":exceptions_enabled": ["ABSL_CI_EXPECT_EXCEPTIONS_ENABLED=1"],
        ":exceptions_disabled": ["ABSL_CI_EXPECT_EXCEPTIONS_DISABLED=1"],
        "//conditions:default": [],
    }) + select({
        ":asan_enabled": ["ABSL_CI_EXPECT_SANITIZER_ASAN=1"],
        ":tsan_enabled": ["ABSL_CI_EXPECT_SANITIZER_TSAN=1"],
        ":msan_enabled": ["ABSL_CI_EXPECT_SANITIZER_MSAN=1"],
        "//conditions:default": [],
    }),
)

# Architecture verification tests
sh_test(
    name = "x86_64_architecture_test",
    srcs = ["verify_binary.sh"],
    args = [
        "$(rootpath :toolchain_test)",
        "arch",
        "X86-64",
    ],
    data = [":toolchain_test"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

sh_test(
    name = "aarch64_architecture_test",
    srcs = ["verify_binary.sh"],
    args = [
        "$(rootpath :toolchain_test)",
        "arch",
        "AArch64",
    ],
    data = [":toolchain_test"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

# Compiler ELF .comment verification tests
sh_test(
    name = "clang_verification_test",
    srcs = ["verify_binary.sh"],
    args = [
        "$(rootpath :toolchain_test)",
        "comment",
        "clang version",
    ],
    data = [":toolchain_test"],
    target_compatible_with = [
        "@platforms//os:linux",
    ] + select({
        ":clang_compiler": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

