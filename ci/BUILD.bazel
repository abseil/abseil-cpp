    srcs = ["verify_binary.sh"],
    args = [
        "$(rootpath :toolchain_test)",
        "needed",
        "libc++.so",
    ],
    data = [":toolchain_test"],
    target_compatible_with = [
        "@platforms//os:linux",
    ] + select({
        ":libcxx_enabled": [],
