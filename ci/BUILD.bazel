load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

string_flag(
    name = "compiler",
    build_setting_default = "none",
)

config_setting(
    name = "clang_compiler",
    flag_values = {":compiler": "clang"},
)

config_setting(
    name = "gcc_compiler",
    flag_values = {":compiler": "gcc"},
)

config_setting(
    name = "msvc_compiler",
    flag_values = {":compiler": "msvc"},
)

config_setting(
    name = "clang_cl_compiler",
    flag_values = {":compiler": "clang-cl"},
)

string_flag(
    name = "stdlib",
    build_setting_default = "none",
)

config_setting(
    name = "libcxx_enabled",
    flag_values = {":stdlib": "libc++"},
)

config_setting(
    name = "libstdcxx_enabled",
    flag_values = {":stdlib": "libstdc++"},
)

config_setting(
    name = "msvc_stdlib_enabled",
    flag_values = {":stdlib": "msvc"},
)

string_flag(
    name = "exceptions",
    build_setting_default = "none",
)

config_setting(
    name = "exceptions_enabled",
    flag_values = {":exceptions": "enabled"},
)

config_setting(
    name = "exceptions_disabled",
    flag_values = {":exceptions": "disabled"},
)

string_flag(
    name = "sanitizer",
    build_setting_default = "none",
)

config_setting(
    name = "asan_enabled",
    flag_values = {":sanitizer": "asan"},
)

config_setting(
    name = "tsan_enabled",
